    {
      "parameters": {
        "jsCode": "const action = $json.params?.action ?? '';\nconst body = $json.body ?? {};\nconst allowed = ['search', 'product', 'info', 'callback', 'handoff'];\nif (!allowed.includes(action)) return [{ json: { __bad: true } }];\nreturn [{ json: { ...body, action } }];",
        "mode": "runOnceForAllItems"
      },
