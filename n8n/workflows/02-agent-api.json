      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "name": "ShopAgent DB"
        }
      }
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select jsonb_build_object(\n  'as_of', to_char(now() at time zone 'Europe/Berlin', 'YYYY-MM-DD'),\n  'product', jsonb_build_object(\n    'sku', p.sku,\n    'name', p.name,\n    'description', p.description,\n    'price_eur', round(p.price_cents / 100.0, 2),\n    'availability', p.availability,\n    'url', p.product_url,\n    'image_url', p.image_url,\n    'brand', p.brand,\n    'category', p.category,\n    'last_seen', p.last_seen_at\n  ),\n  'variants', '[]'::jsonb\n) as result\nfrom products p\nwhere p.is_active\n  and (p.sku = $1 or p.slug = $1 or p.name ilike '%' || $1 || '%')\norder by (p.sku = $1 or p.slug = $1) desc, similarity(p.name, $1) desc\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [$json.sku || $json.name] }}"
        }
      },
      "id": "agent-api-product",
      "name": "Produkt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1100,
        -160
