        "query": "select search_products($1, $2, $3, $4, 5) as result;",
        "options": {
          "queryReplacement": "={{ [$json.query, $json.category || null, $json.max_price_eur != null ? Math.round($json.max_price_eur * 100) : null, $json.in_stock_only ?? false] }}"
        }
