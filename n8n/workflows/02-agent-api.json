        }
      }
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select jsonb_build_object('ok', true, 'action', 'transfer', 'reason', $1) as result;",
        "options": {
          "queryReplacement": "={{ [$json.reason] }}"
        }
      },
      "id": "agent-api-handoff",
      "name": "Übergabe",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1100,
        320
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "name": "ShopAgent DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const action = $('Route').first().json.action;\nif ($json.error) {\n  return [{ json: { ok: false, message: 'Die Daten sind gerade nicht erreichbar.' } }];\n}\nconst row = $json.result ?? $json;\nif (row == null || (typeof row === 'object' && Object.keys(row).length === 0)) {\n  return [{ json: { ok: false, message: 'Dazu habe ich gerade keine Information.' } }];\n}\nif (action === 'callback') {\n  if (row.id == null) return [{ json: { ok: false, message: 'Der Rückruf konnte gerade nicht notiert werden.' } }];\n  return [{ json: { ok: true, reference: String(row.id).slice(0, 8) } }];\n}\nreturn [{ json: row }];",
        "mode": "runOnceForAllItems"
      },
      "id": "agent-api-format",
      "name": "Antwort formen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
