      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "name": "ShopAgent DB"
        }
      }
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "insert into callbacks (name, phone, reason) values ($1, $2, $3) returning id;",
        "options": {
          "queryReplacement": "={{ [$json.name || null, $json.phone, $json.reason] }}"
        }
      },
      "id": "agent-api-callback",
      "name": "Rückruf",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1100,
        160
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
