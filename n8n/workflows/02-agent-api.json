    },
    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select jsonb_build_object(\n  'answer', content_md,\n  'source_url', url,\n  'as_of', to_char(updated_at at time zone 'Europe/Berlin', 'YYYY-MM-DD')\n) as result\nfrom pages\nwhere topic = $1\norder by updated_at desc\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [$json.topic] }}"
        }
      },
